{
  "name": "turva-worker",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public"
  },
  // Off on purpose: a *.workers.dev hostname would serve the whole site outside the
  // turva.dev zone, where the zone rules (including the /llms-txt-validator rate-limit
  // rule) do not apply and every canonical URL points somewhere else. Routes below are
  // the only public entry points.
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "compatibility_date": "2026-04-09",
  "routes": [
    {
      "pattern": "mta-sts.turva.dev/*",
      "zone_name": "turva.dev"
    },
    {
      "pattern": "turva.dev/*",
      "zone_name": "turva.dev"
    }
  ],
  "triggers": {
    "crons": ["0 6 * * 1"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
