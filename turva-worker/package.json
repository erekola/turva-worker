  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.tools.json",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "dependencies": {
    "markdown-parity-check": "0.2.29"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260523.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "@cloudflare/workers-types": "$@cloudflare/workers-types"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true,
    "workerd@1.20261023.1": true
  }
